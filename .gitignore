# Root .gitignore for monorepo / multi-app workspace

# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Production build outputs
dist/
*/dist/
dist-ssr/
build/
*/build/

# Environment and sensitive variables
.env
.env.*
!.env.example
*.env
**/.env
**/.env.*
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and OS directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Test coverage
coverage/
*.lcov
.nyc_output
